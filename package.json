{
    "name": "fntv",
    "version": "2.8.0",
    "description": "A fntv app built with Electron",
    "main": "dest/main/main.js",
    "packageManager": "pnpm@12.18.0",
    "scripts": {
        "build:proxy:win": "cd src/modules/proxy && go build -o ../../../third_party/proxy/proxy.exe",
        "build:proxy:linux": "pnpm run build:proxy:linux:x64",
        "build:proxy:linux:x64": "cd src/modules/proxy && cross-env GOOS=linux GOARCH=amd64 go build -o ../../../third_party/proxy/proxy",
        "build:proxy:linux:arm64": "cd src/modules/proxy && cross-env GOOS=linux GOARCH=arm64 go build -o ../../../third_party/proxy/proxy",
        "build:proxy:mac:x64": "cd src/modules/proxy && GOOS=darwin GOARCH=amd64 go build -o ../../../third_party/proxy/proxy_x64",
        "build:proxy:mac:arm64": "cd src/modules/proxy && GOOS=darwin GOARCH=arm64 go build -o ../../../third_party/proxy/proxy_arm64",
        "build:proxy:mac": "cd src/modules/proxy && go build -o ../../../third_party/proxy/proxy",
        "build:proxy:mac:universal": "lipo -create -output third_party/proxy/proxy third_party/proxy/proxy_x64 third_party/proxy/proxy_arm64",
        "clean:proxy:mac": "rimraf third_party/proxy/proxy_x64 third_party/proxy/proxy_arm64",
        "start": "pnpm run clean && pnpm run build:proxy:win && tsc && pnpm run build:preload && electron .",
        "start:mac": "pnpm run clean && pnpm run build:proxy:mac && pnpm run compile && electron .",
        "compile": "pnpm run clean && tsc && pnpm run build:preload",
        "build:preload": "node scripts/build-preload.cjs",
        "lint": "eslint src resource/login tests",
        "prepare": "git config core.hooksPath .githooks",
        "test": "pnpm run compile && node --test tests/*.test.cjs",
        "test:smoke": "node --test --test-reporter=spec --test-timeout=300000 tests/smoke/installer.smoke.cjs",
        "watch": "node scripts/build-preload.cjs --watch",
        "clean": "rimraf dest",
        "build:win": "pnpm run build:proxy:win && pnpm run compile && electron-builder --win --publish never",
        "build:mac": "pnpm run build:proxy:mac:x64 && pnpm run build:proxy:mac:arm64 && pnpm run build:proxy:mac:universal && pnpm run compile && pnpm run clean:proxy:mac && electron-builder --mac --publish never",
        "build:linux:x64": "pnpm run build:proxy:linux:x64 && pnpm run compile && electron-builder --linux AppImage --x64 --publish never",
        "build:linux:arm64": "pnpm run build:proxy:linux:arm64 && pnpm run compile && electron-builder --linux AppImage --arm64 --publish never",
        "build:linux": "pnpm run build:linux:x64 && pnpm run build:linux:arm64",
        "generate-iconset": "node scripts/generate-iconset.js",
        "generate-icns": "bash scripts/generate-icns.sh"
    },
    "author": "JayYa",
    "license": "GPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JayYa/fntv-electron.git"
    },
    "homepage": "https://github.com/JayYa/fntv-electron#readme",
    "bugs": {
        "url": "https://github.com/JayYa/fntv-electron/issues"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "copyfiles": "2.4.1",
        "cross-env": "10.1.0",
        "electron": "45.2.3",
        "electron-builder": "26.18.0",
        "esbuild": "0.28.2",
        "eslint": "10.14.0",
        "js-yaml": "5.5.0",
        "playwright-core": "1.65.0",
        "rimraf": "6.1.4",
        "sharp": "0.35.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "dependencies": {
        "axios": "1.21.0",
        "node-cache": "5.1.2",
        "node-mpv-2": "2.0.0-beta.3",
        "semver": "7.8.6"
    },
    "build": {
        "directories": {
            "output": "release"
        },
        "icon": "build/icon.ico",
        "productName": "飞牛影视",
        "artifactName": "FNMedia_${version}_${os}_${arch}.${ext}",
        "appId": "com.qiaokes.fntv",
        "copyright": "Copyright (c) 2025 Tag mig hånden and fntv-electron contributors; modifications (c) 2026 JayYa",
        "compression": "normal",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "extraFiles": [
                {
                    "from": "third_party/fntv-mpv",
                    "to": "third_party/fntv-mpv",
                    "filter": [
                        "**/*"
                    ]
                },
                {
                    "from": "third_party/proxy",
                    "to": "third_party/proxy",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.entertainment",
            "icon": "build/icon.icns",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "type": "development",
            "extraFiles": [
                {
                    "from": "third_party/fntv-mpv/portable_config",
                    "to": "third_party/fntv-mpv/portable_config",
                    "filter": [
                        "**/*"
                    ]
                },
                {
                    "from": "third_party/proxy",
                    "to": "third_party/proxy",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "dmg": {
            "title": "FNMedia_${version}_${arch}",
            "icon": "build/icon.icns",
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "AudioVideo",
            "icon": "build/icon.png",
            "desktop": {
                "entry": {
                    "Name": "飞牛影视",
                    "Comment": "飞牛影视播放器",
                    "Categories": "AudioVideo;Video;Player;"
                }
            },
            "extraFiles": [
                {
                    "from": "third_party/fntv-mpv/portable_config",
                    "to": "third_party/fntv-mpv/portable_config",
                    "filter": [
                        "**/*"
                    ]
                },
                {
                    "from": "third_party/proxy",
                    "to": "third_party/proxy",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "oneClick": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "dest",
            "build",
            "resource/login"
        ]
    }
}
