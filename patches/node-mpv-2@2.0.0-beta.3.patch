 const exec  = require('child_process').exec;
 const stat = require('fs').stat;
+const StringDecoder = require('string_decoder').StringDecoder;
 
 const ErrorHandler = require('./error');
 
 const util = {
+	// fntv-electron patch: one mpv message may arrive in several socket chunks.
+	// Returns a function that takes a chunk and returns the complete lines received
+	// so far, keeping the trailing partial line (and any split UTF-8 character)
+	// until the rest arrives. Use one splitter per socket connection.
+	lineSplitter: function() {
+		const decoder = new StringDecoder('utf8');
+		let pending = '';
+		return function(data) {
+			const lines = (pending + decoder.write(data)).split('\n');
+			pending = lines.pop();
+			return lines;
+		};
+	},
